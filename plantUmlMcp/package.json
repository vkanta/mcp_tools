{
  "name": "plantuml-mcp-server",
  "version": "1.0.0",
  "description": "A Model Context Protocol server for PlantUML diagram generation and management",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "plantuml-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plantuml",
    "diagrams",
    "typescript"
  ],
  "author": "Vasileios Kantartzis <vkanta@yahoo.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0",
    "node-plantuml": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "build",
    "README.md"
  ]
}
